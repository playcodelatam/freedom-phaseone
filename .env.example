# ExploitGym — Environment Variables Template
# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings → Environment Variables.

# -------------------------------------------------------
# SUPABASE — Multiplayer Rooms (presence + broadcast only)
# Get these from your Supabase project → Settings → API
# Solo play works with NO Supabase config at all.
# -------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# -------------------------------------------------------
# CLOUDFLARE TURN — WebRTC Voice Chat Relay
# Optional: voice falls back to public STUN + OpenRelay TURN
# without these. Set them for better NAT traversal in prod.
# Get credentials from: Cloudflare Dashboard → Calls → TURN
# -------------------------------------------------------
CF_TURN_KEY_ID=your-cloudflare-turn-key-id
CF_TURN_API_TOKEN=your-cloudflare-turn-api-token
